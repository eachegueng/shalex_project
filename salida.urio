/*
    Reorganiza el flujo: primero bucle, luego lectura, 
    operaciones con paréntesis, condicionales y salida.
*/
real bono = 2.50;
entero monedas = 15;
crear Heroe = 'Luigi';
// Bucle mientras primero para reducir monedas y aumentar bono
mientras (monedas > 10) [
monedas = monedas - 1;
bono = (bono + 1.50) * 2;
]
// Lectura de datos a mitad del programa
leer(monedas);
// Condicionales con operadores relacionales distintos (==, <)
si (monedas == 0) [
bono = 0.00;
] sino si (monedas < 5) [
monedas = monedas + (2 * 3);
] sino [
bono = bono / 2;
]
// Salidas en consola al final
mostrar(Heroe);
mostrar(monedas);
mostrar(bono);
